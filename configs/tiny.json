    "warmup_iters": 50,
    "lr_decay_iters": 1000,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "device": "auto",
    "dtype": "auto",
    "compile": false
  }
}

