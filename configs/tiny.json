{
  "model": {
    "block_size": 128,
    "n_layer": 4,
    "n_head": 4,
    "n_embd": 128,
    "dropout": 0.1,
    "bias": true
  },
  "train": {
    "batch_size": 32,
    "max_iters": 1000,
